generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  PRESIDENT
  SECRETARIAT
  TREASURER
  COMMUNICATION
  SUPER_ADMIN
  EVENT_ORGANIZER
  VICE_PRESIDENT
  COORDINATOR
}
enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  REJECTED
}
enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}
enum TransactionType {
  INCOME
  EXPENSE
}

model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role Role @default(MEMBER)
 active Boolean @default(true)
 mustChangePassword Boolean @default(false)
 emailVerifiedAt DateTime?
 lastLoginAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 member Member?
}
model Member {
 id String @id @default(cuid())
 memberNumber String? @unique
 userId String? @unique
 fullName String
 photoUrl String?
 dateOfBirth DateTime?
 phone String?
 city String
 address String?
 status String
 university String?
 fieldOfStudy String?
 profession String?
 emergencyName String?
 emergencyPhone String?
 membershipStatus MembershipStatus @default(PENDING)
 publicProfile Boolean @default(false)
 approvedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([city])
 @@index([university])
 @@index([fieldOfStudy])
 @@index([membershipStatus])
 user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
 contributions Contribution[]
 eventRegistrations EventRegistration[]
 participations ActivityParticipation[]
}
model Registration {
 id String @id @default(cuid())
 email String
 fullName String
 payload Json
 status RegistrationStatus @default(PENDING)
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
}
model Activity {
 id String @id @default(cuid())
 title String
 slug String @unique
 date DateTime
 location String?
 description String
 coverImageUrl String?
 published Boolean @default(false)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 images ActivityImage[]
 participations ActivityParticipation[]
}
model ActivityParticipation {
 id String @id @default(cuid())
 activityId String
 memberId String
 createdAt DateTime @default(now())
 activity Activity @relation(fields:[activityId],references:[id],onDelete:Cascade)
 member Member @relation(fields:[memberId],references:[id],onDelete:Cascade)
 @@unique([activityId,memberId])
 @@index([activityId])
 @@index([memberId])
}

model ActivityImage {
 id String @id @default(cuid())
 activityId String
 url String
 mediaType String @default("IMAGE")
 altText String?
 caption String?
 sortOrder Int @default(0)
 activity Activity @relation(fields:[activityId],references:[id],onDelete:Cascade)
}
model Event {
 id String @id @default(cuid())
 title String
 description String
 startAt DateTime
 endAt DateTime?
 location String?
 coverImageUrl String?
 status EventStatus @default(DRAFT)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 registrations EventRegistration[]
 eventPlan EventPlan?
}
model EventRegistration {
 id String @id @default(cuid())
 eventId String
 memberId String
 createdAt DateTime @default(now())
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 member Member @relation(fields:[memberId],references:[id],onDelete:Cascade)
 @@unique([eventId,memberId])
}
model EventPlan {
 id String @id @default(cuid())
 eventId String @unique
 objective String?
 expectedAttendance Int?
 audience String?
 budget Decimal @default(0) @db.Decimal(12,2)
 venueDetails String?
 transportPlan String?
 accommodationPlan String?
 cateringPlan String?
 securityPlan String?
 communicationsPlan String?
 contingencyPlan String?
 program String?
 notes String?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 tasks EventPlanTask[]
 @@index([eventId])
}

model EventPlanTask {
 id String @id @default(cuid())
 planId String
 title String
 description String?
 assignee String?
 dueAt DateTime?
 priority String @default("MEDIUM")
 status String @default("TODO")
 sortOrder Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 plan EventPlan @relation(fields:[planId],references:[id],onDelete:Cascade)
 @@index([planId])
}

model Announcement {
 id String @id @default(cuid())
 title String
 body String
 priority String @default("NORMAL")
 published Boolean @default(false)
 publishedAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Contribution {
 id String @id @default(cuid())
 memberId String
 amount Decimal @db.Decimal(12,2)
 reference String?
 paidAt DateTime
 note String?
 createdBy String
 member Member @relation(fields:[memberId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
}
model Transaction {
 id String @id @default(cuid())
 type TransactionType
 amount Decimal @db.Decimal(12,2)
 category String
 description String
 reference String?
 receiptUrl String?
 occurredAt DateTime
 createdBy String
 createdAt DateTime @default(now())
 @@index([reference])
}
model Document {
 id String @id @default(cuid())
 title String
 category String
 url String
 visibility String @default("PRIVATE")
 uploadedBy String
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 actorUserId String?
 action String
 entity String
 entityId String?
 metadata Json?
 ipHash String?
 createdAt DateTime @default(now())
}
